@inherits LayoutComponentBase

<div class="flex flex-col md:flex-row min-h-screen">
    <!-- Sidebar -->
    <div class="bg-gradient-to-b from-[#052767] to-[#3a0647] w-full md:w-[250px] md:h-screen sticky top-0">
        <NavMenu />
    </div>

    <!-- Main content -->
    <main class="flex-1">
        <!-- Top row -->
        <div class="bg-gray-100 border-b border-gray-300 h-14 flex items-center justify-end px-4 sticky top-0 z-10">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank"
               class="ml-6 text-blue-700 hover:underline whitespace-nowrap overflow-hidden text-ellipsis">
                About
            </a>
        </div>

        <!-- Main content area -->
        <article class="px-6 py-4">
            @Body
        </article>
    </main>
</div>
