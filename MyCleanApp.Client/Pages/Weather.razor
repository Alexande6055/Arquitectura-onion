@page "/weather"
@inject HttpClient Http

<PageTitle>Weather</PageTitle>

<h1 class="text-3xl font-bold mb-4 text-blue-700">Pronóstico del tiempo</h1>

<p class="mb-6 text-gray-600">Este componente muestra datos obtenidos del servidor.</p>

@if (forecasts == null)
{
    <p><em class="text-gray-500">Cargando...</em></p>
}
else
{
    <div class="overflow-x-auto">
        <table class="min-w-full bg-white border border-gray-200 rounded-lg shadow-md">
            <thead class="bg-blue-600 text-white">
                <tr>
                    <th class="py-3 px-6 text-left">Fecha</th>
                    <th class="py-3 px-6 text-left" aria-label="Temperatura en Celsius">Temp. (°C)</th>
                    <th class="py-3 px-6 text-left" aria-label="Temperatura en Fahrenheit">Temp. (°F)</th>
                    <th class="py-3 px-6 text-left">Resumen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var forecast in forecasts)
                {
                    <tr class="border-t border-gray-200 hover:bg-blue-50">
                        <td class="py-2 px-6">@forecast.Date.ToShortDateString()</td>
                        <td class="py-2 px-6">@forecast.TemperatureC</td>
                        <td class="py-2 px-6">@forecast.TemperatureF</td>
                        <td class="py-2 px-6">@forecast.Summary</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        forecasts = await Http.GetFromJsonAsync<WeatherForecast[]>("api/weatherforecast");
    }

    public class WeatherForecast
    {
        public DateOnly Date { get; set; }

        public int TemperatureC { get; set; }

        public string? Summary { get; set; }

        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
